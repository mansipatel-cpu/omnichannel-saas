{
  "name": "omnichannel-saas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run dev -w backend",
    "build": "npm run build -w frontend && npm run build -w backend",
    "start": "npm run start -w backend",
    "lint": "eslint .",
    "check": "node scripts/check.mjs",
    "db:push": "node scripts/db-push-non-interactive.mjs",
    "db:migrate": "node scripts/run-safe-migration.mjs",
    "db:generate": "npm run db:generate -w backend",
    "db:seed": "node --import ./scripts/register-esm-paths.mjs backend/src/database/seeders/seed-all.js",
    "db:studio": "npm run db:studio -w backend",
    "db:up": "docker compose -p omnichannel-saas -f backend/docker-compose.yml --env-file backend/.env up -d",
    "db:down": "docker compose -p omnichannel-saas -f backend/docker-compose.yml --env-file backend/.env down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "form-data": "^4.0.0",
    "tough-cookie": "^4.1.3",
    "systeminformation": "^5.31.0",
    "fast-xml-parser": "^5.7.0",
    "qs": "^6.14.2",
    "ajv": "^8.18.0",
    "minimatch": "^10.2.4",
    "@hono/node-server": ">=1.19.13",
    "rollup": ">=4.58.1",
    "basic-ftp": ">=5.3.0",
    "follow-redirects": ">=1.16.0",
    "uuid": "^14.0.0",
    "ip-address": "^10.2.0",
    "ws": "^8.20.1",
    "js-yaml": "^5.2.3"
  }
}
