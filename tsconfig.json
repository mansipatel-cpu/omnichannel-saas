{
  "include": ["client/src/**/*", "client/src/whatsapp/**/*", "shared/**/*", "backend/**/*", "packages/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@wa/*": ["./client/src/whatsapp/*"],
      "@shared/*": ["./shared/*"],
      "@diploy/core": ["./packages/diploy-core/index.ts"],
      "server/*": ["./backend/whatsapp/*"]
    }
  }
}
