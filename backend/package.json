{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --import ../scripts/register-esm-paths.mjs index.js",
    "dev:watch": "cross-env NODE_ENV=development node --watch --watch-path=index.js --watch-path=app.js --watch-path=src --watch-path=../frontend/src --watch-path=../packages --watch-preserve-output --import ../scripts/register-esm-paths.mjs index.js",
    "build": "esbuild index.js --platform=node --packages=external --bundle --format=esm --outdir=../dist --alias:@shared/schema=./src/config/schema.js --alias:@shared/whatsapp-schema=./src/config/whatsapp-schema.js --alias:@shared=../packages/shared --alias:@diploy/core=../packages/diploy-core/index.js",
    "start": "cross-env NODE_ENV=production node --import ../scripts/register-esm-paths.mjs ../dist/index.js",
    "db:push": "node ../scripts/db-push-non-interactive.mjs",
    "db:migrate": "node ../scripts/run-safe-migration.mjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.js",
    "db:seed": "node --import ../scripts/register-esm-paths.mjs src/database/seeders/seed-all.js",
    "db:reset": "node scripts/clean-and-reset-db.mjs && node --import ../scripts/register-esm-paths.mjs src/database/seeders/seed-all.js",
    "db:studio": "drizzle-kit studio --config drizzle.config.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@diploy/core": "*",
    "@elevenlabs/elevenlabs-js": "^2.25.1",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "axios": "^1.15.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.67.2",
    "cheerio": "^1.2.0",
    "chrono-node": "^2.9.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-async-handler": "^1.2.0",
    "express-session": "^1.18.1",
    "express-ws": "^5.0.2",
    "fast-xml-parser": "^5.7.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "mammoth": "^1.12.2",
    "memorystore": "^1.6.7",
    "minimatch": "^10.2.4",
    "multer": "^2.1.1",
    "nanoid": "^5.1.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.4",
    "openai": "^6.9.1",
    "papaparse": "^5.5.3",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "plivo": "4.75.1",
    "pm2": "^7.0.1",
    "redoc-express": "^2.1.3",
    "semver": "^7.7.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.10.4",
    "ws": "^8.20.1",
    "yamljs": "^0.3.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "supertest": "^7.3.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
