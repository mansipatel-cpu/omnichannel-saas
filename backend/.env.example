# =========================================
# Backend environment
# Copy to backend/.env  (never commit .env)
# =========================================

# Database (Docker Compose Postgres on host port 5433)
PGHOST=localhost
PGPORT=5433
PGUSER=agentlabs
PGPASSWORD=your_secure_database_password_here
PGDATABASE=agentlabs
DATABASE_URL=postgresql://agentlabs:your_secure_database_password_here@localhost:5433/agentlabs

# Application
NODE_ENV=development
PORT=5000
APP_PORT=5000
APP_URL=http://localhost:5000
FORCE_HTTPS=false
DEBUG=true
LOG_LEVEL=debug

# Demo mode
DEMO_MODE=false
DEMO_EMAILS=demo@diploy.in,demo1@diploy.in

# Security (npm run setup generates these)
SESSION_SECRET=WILL_BE_AUTO_GENERATED_BY_SETUP
JWT_SECRET=WILL_BE_AUTO_GENERATED_BY_SETUP

# WhatsApp / Meta
WHATSAPP_API_VERSION=v24.0
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
FACEBOOK_APP_ID=

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_API_KEY=
TWILIO_API_SECRET=

# AI / Voice
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
OPENAI_API_KEY=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# Web push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# Voice engine
VE_STREAMING_PLAYBACK=false
PUBLIC_IP=
VE_AUDIO_WS_IP=
DISABLE_FREESWITCH_ESL=false

# Installation
INSTALLER_COMPLETED=false
INSTALLER_VERSION=1.0.0
