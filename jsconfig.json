{
  "compilerOptions": {
    "baseUrl": ".",
    "checkJs": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "paths": {
      "@/*": ["./frontend/src/*"],
      "@wa/*": ["./frontend/src/features/whatsapp/*"],
      "@shared/schema": ["./backend/src/config/schema.js"],
      "@shared/whatsapp-schema": ["./backend/src/config/whatsapp-schema.js"],
      "@shared/*": ["./packages/shared/*"],
      "@diploy/core": ["./packages/diploy-core/index.js"]
    }
  },
  "include": ["frontend/src/**/*", "packages/**/*", "backend/**/*"],
  "exclude": ["node_modules", "dist", "build"]
}
