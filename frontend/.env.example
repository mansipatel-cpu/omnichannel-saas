# =========================================
# Frontend environment (Vite)
# Copy to frontend/.env  (never commit .env)
# Only VITE_* keys are exposed to the browser.
# =========================================

# Public app URL (used in the UI when an absolute origin is needed)
VITE_APP_URL=http://localhost:5000

# API origin. Leave empty to use the same host as the UI (recommended).
# Set this only if the frontend Vite server runs separately from the API.
VITE_API_URL=
